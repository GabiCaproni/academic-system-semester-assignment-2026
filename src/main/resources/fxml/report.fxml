<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.academic.system.controller.ReportController"
      spacing="10"
      alignment="CENTER">

    <Button text="Relatório Resumido"
            onAction="#gerarResumo"/>

    <Button text="Relatório de Peso"
            onAction="#gerarPeso"/>

    <Button fx:id="btnPersistencia"
            text="Relatório Persistência"
            onAction="#gerarPersistencia"/>

    <TextArea fx:id="resultadoArea"
              prefHeight="300"
              prefWidth="500"/>

    <Button text="Voltar ao Menu"
            onAction="#voltar"/>

</VBox>