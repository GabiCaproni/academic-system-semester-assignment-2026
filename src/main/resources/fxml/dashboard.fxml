<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.academic.system.controller.DashboardController"
      alignment="CENTER"
      spacing="10"
      style="-fx-padding: 20; -fx-background-color: #f4f4f4;">

    <Label text="Menu Principal" 
           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

    <Button fx:id="btnCadastrarTurma"
            text="Cadastrar Turma"
            onAction="#abrirCadastroTurma"
            prefWidth="200"
            style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;"/>

    <Button text="Registrar Avaliação"
            onAction="#abrirCadastroAvaliacao"
            prefWidth="200"
            style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;"/>

    <Button text="Visualizar Turmas"
            onAction="#abrirVisualizacao"
            prefWidth="200"
            style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;"/>

    <Button fx:id="btnRelatorios"
            text="Relatórios"
            onAction="#abrirRelatorios"
            prefWidth="200"
            style="-fx-background-color: #9b59b6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;"/>

    <Button text="Logout"
            onAction="#logout"
            prefWidth="200"
            style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;"/>

    <!-- 🔴 BOTÃO SAIR DO SISTEMA - NOVO -->
    <Button text="Sair do Sistema"
            onAction="#sairDoSistema"
            prefWidth="200"
            style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-font-size: 14px;"/>

</VBox>