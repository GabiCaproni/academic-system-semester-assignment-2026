<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.academic.system.controller.ViewClassesController"
      spacing="10"
      alignment="CENTER">

    <Button text="Carregar Turmas"
            onAction="#carregarTurmas"/>

    <TextArea fx:id="resultadoArea"
              prefHeight="500"
              prefWidth="700"/>

    <Button text="Voltar"
            onAction="#voltarDashboard"/>

</VBox>
